# Copy to .env (never commit .env). Every value is optional locally.
NODE_ENV=development
PORT=3000
# Public URL, used in password reset links.
BASE_URL=http://localhost:3000
# Where the SQLite file lives. In production point this OUTSIDE the deployed
# app folder so redeploys never wipe the database.
DATA_DIR=./data
# Set to 1 only when running behind Hostinger's reverse proxy (uses X-Forwarded-For/-Proto).
TRUST_PROXY=0
# console = print password-reset emails to the server log (dev only). none = send nothing.
MAIL_MODE=console
# Event POST rate limit per API key, per hour.
EVENT_RATE_LIMIT_PER_HOUR=600
